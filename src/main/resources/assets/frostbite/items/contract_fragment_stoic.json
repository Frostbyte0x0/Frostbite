{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "BLACK",
        "model": {
          "type": "minecraft:model",
          "model": "frostbite:item/black_fragment"
        }
      },
      {
        "when": "GREY",
        "model": {
          "type": "minecraft:model",
          "model": "frostbite:item/grey_fragment"
        }
      },
      {
        "when": "WHITE",
        "model": {
          "type": "minecraft:model",
          "model": "frostbite:item/white_fragment"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "frostbite:item/white_fragment"
    }
  }
}