{
  "multipart": [
    {
      "apply": {
        "model": "frostbite:block/misty_berry_leaves"
      },
      "when": {
        "snowy": false
      }
    },
    {
      "apply": {
        "model": "frostbite:block/misty_berry_leaves_snow"
      },
      "when": {
        "snowy": true
      }
    },
    {
      "apply": {
        "model": "frostbite:block/misty_berry_leaves_emissive"
      }
    }
  ]
}