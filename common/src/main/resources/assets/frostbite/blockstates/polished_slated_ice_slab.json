{
  "multipart": [
    {
      "apply": {
        "model": "frostbite:block/polished_slated_ice_slab"
      },
      "when": {
        "type": "bottom"
      }
    },
    {
      "apply": {
        "model": "frostbite:block/snow_layer_middle"
      },
      "when": {
        "type": "bottom",
        "snowy": "true"
      }
    },
    {
      "apply": {
        "model": "frostbite:block/polished_slated_ice"
      },
      "when": {
        "type": "double"
      }
    },
    {
      "apply": {
        "model": "frostbite:block/polished_slated_ice_slab_top"
      },
      "when": {
        "type": "top"
      }
    }
  ]
}