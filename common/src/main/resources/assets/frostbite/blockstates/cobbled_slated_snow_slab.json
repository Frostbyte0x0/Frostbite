{
  "multipart": [
    {
      "apply": {
        "model": "frostbite:block/cobbled_slated_snow_slab"
      },
      "when": {
        "type": "bottom"
      }
    },
    {
      "apply": {
        "model": "frostbite:block/snow_layer_middle"
      },
      "when": {
        "type": "bottom",
        "snowy": "true"
      }
    },
    {
      "apply": {
        "model": "frostbite:block/cobbled_slated_snow"
      },
      "when": {
        "type": "double"
      }
    },
    {
      "apply": {
        "model": "frostbite:block/cobbled_slated_snow_slab_top"
      },
      "when": {
        "type": "top"
      }
    }
  ]
}