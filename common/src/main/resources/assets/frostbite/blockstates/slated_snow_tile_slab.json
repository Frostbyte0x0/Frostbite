{
  "multipart": [
    {
      "apply": {
        "model": "frostbite:block/slated_snow_tile_slab"
      },
      "when": {
        "type": "bottom"
      }
    },
    {
      "apply": {
        "model": "frostbite:block/snow_layer_middle"
      },
      "when": {
        "type": "bottom",
        "snowy": "true"
      }
    },
    {
      "apply": {
        "model": "frostbite:block/slated_snow_tile"
      },
      "when": {
        "type": "double"
      }
    },
    {
      "apply": {
        "model": "frostbite:block/slated_snow_tile_slab_top"
      },
      "when": {
        "type": "top"
      }
    }
  ]
}